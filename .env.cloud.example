# Configuração pública do aplicativo web, fornecida pelo Firebase.
# Modelo informativo: scripts/configure-cloud.cjs gera .tools/cloud-demo/config.json.
# Nunca coloque senhas ou chaves Admin na configuração pública do frontend.
EXPO_PUBLIC_FIREBASE_MODE=cloud-demo
EXPO_PUBLIC_FIREBASE_API_KEY=PREENCHA
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=SEU-PROJETO
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=SEU-PROJETO.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=PREENCHA
